e='[Regime]' role='dimension' type='nominal' /><column datatype='real' name='[Value_Pct]' role='measure' type='quantitative' /><column datatype='string' name='[Note]' role='dimension' type='nominal' /><layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' /><style><style-rule element='mark'><encoding attr='color' field='[none:Regime:nk]' type='palette'><map to='#1170AA'><bucket>&quot;Above 252-day MA&quot;</bucket></map><map to='#C85200'><bucket>&quot;Below 252-day MA&quot;</bucket></map></encoding></style-rule></style></datasource></datasources><worksheets><worksheet name="V1 Price trend"><layout-options><title><formatted-text><run bold='true' fontcolor='#333333' fontsize='14'>E-mini Nasdaq-100: a 27-year climb from the dot-com peak, through two deep bear markets</run><run>Æ&#10;</run><run fontcolor='#555555' fontsize='10'>Daily settlement of the front-month NQ contract and its 252-day moving average, Jun 1999 – Oct 2026  |  ×12.3 (≈9.6% a year)</run><run>Æ&#10;</run><run fontcolor='#555555' fontsize='10'>Log scale: equal vertical distances are equal percentage moves. Source: CME Globex via TradingView (CME_MINI:NQ1!).</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="V1_price" name='federated.nq1poster00' /></datasources><datasource-dependencies datasource='federated.nq1poster00'><column datatype='date' name='[Date]' role='dimension' type='ordinal' /><column datatype='string' name='[Series]' role='dimension' type='nominal' /><column datatype='real' name='[Price]' role='measure' type='quantitative' /><column datatype='string' name='[Note]' role='dimension' type='nominal' /><column-instance column='[Date]' derivation='None' name='[none:Date:qk]' pivot='key' type='quantitative' /><column-instance column='[Price]' derivation='Sum' name='[sum:Price:qk]' pivot='key' type='quantitative' /><column-instance column='[Series]' derivation='None' name='[none:Series:nk]' pivot='key' type='nominal' /><column-instance column='[Note]' derivation='Attribute' name='[attr:Note:nk]' pivot='key' type='nominal' /></datasource-dependencies><aggregation value='true' /></view><style><style-rule element='axis'><encoding attr='space' class='0' field='[federated.nq1poster00].[sum:Price:qk]' field-type='quantitative' scope='rows' type='space' scale='log' range-type='fixed' min='400' max='60000' /><format attr='title' class='0' field='[federated.nq1poster00].[sum:Price:qk]' scope='rows' value="Price (index points, log scale)" /><encoding attr='space' class='0' field='[federated.nq1poster00].[none:Date:qk]' field-type='quantitative' scope='cols' type='space'  /><format attr='title' class='0' field='[federated.nq1poster00].[none:Date:qk]' scope='cols' value="Date (trading day)" /></style-rule><style-rule element='gridline'><format attr='stroke-color' value='#E6E6E6' /></style-rule><style-rule element='worksheet'><format attr='font-family' value='Arial' /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Line' /><encodings><color column='[federated.nq1poster00].[none:Series:nk]' /><text column='[federated.nq1poster00].[attr:Note:nk]' /></encodings><style><style-rule element='mark'><format attr='mark-labels-show' value='true' /><format attr='mark-labels-cull' value='false' /></style-rule></style></pane></panes><rows>[federated.nq1poster00].[sum:Price:qk]</rows><cols>[federated.nq1poster00].[none:Date:qk]</cols></table></worksheet><worksheet name="V2 Drawdown"><layout-options><title><formatted-text><run bold='true' fontcolor='#333333' fontsize='14'>Drawdown from previous high: the March 2000 peak took 16 years to regain</run><run>Æ&#10;</run><run fontcolor='#555555' fontsize='10'>Percentage below the highest settlement so far; each label quotes the episode's own peak-to-trough fall</run><run>Æ&#10;</run><run fontcolor='#555555' fontsize='10'>The GFC trough sits inside the dot-com drawdown, so its plotted depth is measured from 2000; its own fall from the Oct 2007 high was −54%.</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="V2_drawdown" name='federated.nq1poster01' /></datasources><datasource-dependencies datasource='federated.nq1poster01'><column datatype='date' name='[Date]' role='dimension' type='ordinal' /><column datatype='real' name='[Drawdown_Pct]' role='measure' type='quantitative' /><column datatype='string' name='[Note]' role='dimension' type='nominal' /><column-instance column='[Date]' derivation='None' name='[none:Date:qk]' pivot='key' type='quantitative' /><column-instance column='[Drawdown_Pct]' derivation='Sum' name='[sum:Drawdown_Pct:qk]' pivot='key' type='quantitative' /><column-instance column='[Note]' derivation='Attribute' name='[attr:Note:nk]' pivot='key' type='nominal' /></datasource-dependencies><aggregation value='true' /></view><style><style-rule element='axis'><encoding attr='space' class='0' field='[federated.nq1poster01].[sum:Drawdown_Pct:qk]' field-type='quantitative' scope='rows' type='space' range-type='fixed' min='-100' max='2' /><format attr='title' class='0' field='[federated.nq1poster01].[sum:Drawdown_Pct:qk]' scope='rows' value="Drawdown from running peak (%)" /><encoding attr='space' class='0' field='[federated.nq1poster01].[none:Date:qk]' field-type='quantitative' scope='cols' type='space'  /><format attr='title' class='0' field='[federated.nq1poster01].[none:Date:qk]' scope='cols' value="Date (trading day)" /></style-rule><style-rule element='gridline'><format attr='stroke-color' value='#E6E6E6' /></style-rule><style-rule element='worksheet'><format attr='font-family' value='Arial' /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Area' /><encodings><text column='[federated.nq1poster01].[attr:Note:nk]' /></encodings><style><style-rule element='mark'><format attr='mark-color' value='#C85200' /><format attr='mark-labels-show' value='true' /><format attr='mark-labels-cull' value='false' /></style-rule></style></pane></panes><rows>[federated.nq1poster01].[sum:Drawdown_Pct:qk]</rows><cols>[federated.nq1poster01].[none:Date:qk]</cols></table></worksheet><worksheet name="V3 Annual returns"><layout-options><title><formatted-text><run bold='true' fontcolor='#333333' fontsize='14'>Calendar-year return: 20 of 26 full years positive, but losses cluster in runs</run><run>Æ&#10;</run><run fontcolor='#555555' fontsize='10'>Year-end to year-end change in settlement; 1999 runs from 30 Jun, 2026 is year-to-date (lighter bars). Dashed line: median of full years.</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="V3_annual" name='federated.nq1poster02' /></datasources><datasource-dependencies datasource='federated.nq1poster02'><column datatype='string' name='[Year]' role='dimension' type='nominal' /><column datatype='real' name='[Annual_Return_Pct]' role='measure' type='quantitative' /><column datatype='real' name='[Full_Year_Return_Pct]' role='measure' type='quantitative' /><column datatype='string' name='[Result]' role='dimension' type='nominal' /><column datatype='string' name='[Note]' role='dimension' type='nominal' /><column-instance column='[Year]' derivation='None' name='[none:Year:nk]' pivot='key' type='nominal' /><column-instance column='[Annual_Return_Pct]' derivation='Sum' name='[sum:Annual_Return_Pct:qk]' pivot='key' type='quantitative' /><column-instance column='[Result]' derivation='None' name='[none:Result:nk]' pivot='key' type='nominal' /><column-instance column='[Full_Year_Return_Pct]' derivation='Sum' name='[sum:Full_Year_Return_Pct:qk]' pivot='key' type='quantitative' /><column-instance column='[Note]' derivation='Attribute' name='[attr:Note:nk]' pivot='key' type='nominal' /></datasource-dependencies><aggregation value='true' /></view><style><style-rule element='axis'><encoding attr='space' class='0' field='[federated.nq1poster02].[sum:Annual_Return_Pct:qk]' field-type='quantitative' scope='rows' type='space' range-type='fixed' min='-52' max='72' /><format attr='title' class='0' field='[federated.nq1poster02].[sum:Annual_Return_Pct:qk]' scope='rows' value="Annual price return (%)" /></style-rule><style-rule element='refline'><format attr='stroke-color' id='refline0' value='#7F7F7F' /><format attr='line-pattern' id='refline0' value='dashed' /></style-rule><style-rule element='gridline'><format attr='stroke-color' value='#E6E6E6' /></style-rule><style-rule element='worksheet'><format attr='font-family' value='Arial' /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Bar' /><encodings><color column='[federated.nq1poster02].[none:Result:nk]' /><text column='[federated.nq1poster02].[attr:Note:nk]' /><lod column='[federated.nq1poster02].[sum:Full_Year_Return_Pct:qk]' /></encodings><reference-line axis-column='[federated.nq1poster02].[sum:Annual_Return_Pct:qk]' enable-instant-analytics='true' formula='median' id='refline0' label="Median, full years: 17%" label-type='custom' scope='per-table' value-column='[federated.nq1poster02].[sum:Full_Year_Return_Pct:qk]' z-order='1' /><style><style-rule element='mark'><format attr='mark-labels-show' value='true' /><format attr='mark-labels-cull' value='false' /></style-rule></style></pane></panes><rows>[federated.nq1poster02].[sum:Annual_Return_Pct:qk]</rows><cols>[federated.nq1poster02].[none:Year:nk]</cols></table></worksheet><worksheet name="V4 Volatility"><layout-options><title><formatted-text><run bold='true' fontcolor='#333333' fontsize='14'>Volatility clusters: calm regimes punctuated by short, violent storms</run><run>Æ&#10;</run><run fontcolor='#555555' fontsize='10'>Rolling 21-day standard deviation of daily log returns × √252; dashed lines are the median and the stress line (90th percentile)</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="V4_volatility" name='federated.nq1poster03' /></datasources><datasource-dependencies datasource='federated.nq1poster03'><column datatype='date' name='[Date]' role='dimension' type='ordinal' /><column datatype='real' name='[Volatility_Pct]' role='measure' type='quantitative' /><column datatype='string' name='[Note]' role='dimension' type='nominal' /><column-instance column='[Date]' derivation='None' name='[none:Date:qk]' pivot='key' type='quantitative' /><column-instance column='[Volatility_Pct]' derivation='Sum' name='[sum:Volatility_Pct:qk]' pivot='key' type='quantitative' /><column-instance column='[Note]' derivation='Attribute' name='[attr:Note:nk]' pivot='key' type='nominal' /></datasource-dependencies><aggregation value='true' /></view><style><style-rule element='axis'><encoding attr='space' class='0' field='[federated.nq1poster03].[sum:Volatility_Pct:qk]' field-type='quantitative' scope='rows' type='space' range-type='fixed' min='0' max='115' /><format attr='title' class='0' field='[federated.nq1poster03].[sum:Volatility_Pct:qk]' scope='rows' value="21-day realised volatility, annualised (%)" /><encoding attr='space' class='0' field='[federated.nq1poster03].[none:Date:qk]' field-type='quantitative' scope='cols' type='space'  /><format attr='title' class='0' field='[federated.nq1poster03].[none:Date:qk]' scope='cols' value="Date (trading day)" /></style-rule><style-rule element='refline'><format attr='stroke-color' id='refline0' value='#7F7F7F' /><format attr='line-pattern' id='refline0' value='dashed' /><format attr='stroke-color' id='refline1' value='#C85200' /><format attr='line-pattern' id='refline1' value='dashed' /></style-rule><style-rule element='gridline'><format attr='stroke-color' value='#E6E6E6' /></style-rule><style-rule element='worksheet'><format attr='font-family' value='Arial' /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Line' /><encodings><text column='[federated.nq1poster03].[attr:Note:nk]' /></encodings><reference-line axis-column='[federated.nq1poster03].[sum:Volatility_Pct:qk]' enable-instant-analytics='true' formula='median' id='refline0' label="Median: 18%" label-type='custom' scope='per-table' value-column='[federated.nq1poster03].[sum:Volatility_Pct:qk]' z-order='1' /><reference-line axis-column='[federated.nq1poster03].[sum:Volatility_Pct:qk]' enable-instant-analytics='true' formula='constant' id='refline1' label="Stress line (90th percentile): 40%" label-type='custom' scope='per-table' value-column='[federated.nq1poster03].[sum:Volatility_Pct:qk]' value='40.01' z-order='2' /><style><style-rule element='mark'><format attr='mark-color' value='#1170AA' /><format attr='mark-labels-show' value='true' /><format attr='mark-labels-cull' value='false' /></style-rule></style></pane></panes><rows>[federated.nq1poster03].[sum:Volatility_Pct:qk]</rows><cols>[federated.nq1poster03].[none:Date:qk]</cols></table></worksheet><worksheet name="V5 Fat tails"><layout-options><title><formatted-text><run bold='true' fontcolor='#333333' fontsize='14'>Daily returns have fat tails: extreme days are far more common than a bell curve predicts</run><run>Æ&#10;</run><run fontcolor='#555555' fontsize='10'>Histogram of 6,872 daily log returns against a normal curve with the same mean and s.d.</run><run>Æ&#10;</run><run fontcolor='#555555' fontsize='10'>Excess kurtosis 7.1  |  beyond ±3 s.d.: 117 days observed vs 19 expected  |  beyond ±4 s.d.: 47 vs 0.4</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="V5_distribution" name='federated.nq1poster04' /></datasources><datasource-dependencies datasource='federated.nq1poster04'><column datatype='real' name='[Return_Bin_Pct]' role='dimension' type='quantitative' /><column datatype='real' name='[Observed_Days]' role='measure' type='quantitative' /><column datatype='real' name='[Normal_Expected_Days]' role='measure' type='quantitative' /><column datatype='string' name='[Note]' role='dimension' type='nominal' /><column-instance column='[Return_Bin_Pct]' derivation='None' name='[none:Return_Bin_Pct:qk]' pivot='key' type='quantitative' /><column-instance column='[Observed_Days]' derivation='Sum' name='[sum:Observed_Days:qk]' pivot='key' type='quantitative' /><column-instance column='[Normal_Expected_Days]' derivation='Sum' name='[sum:Normal_Expected_Days:qk]' pivot='key' type='quantitative' /><column-instance column='[Note]' derivation='Attribute' name='[attr:Note:nk]' pivot='key' type='nominal' /></datasource-dependencies><aggregation value='true' /></view><style><style-rule element='axis'><encoding attr='space' class='0' field='[federated.nq1poster04].[sum:Observed_Days:qk]' field-type='quantitative' scope='rows' type='space' scale='log' range-type='fixedmin' min='0.7' /><format attr='title' class='0' field='[federated.nq1poster04].[sum:Observed_Days:qk]' scope='rows' value="Number of days (log scale)" /><encoding attr='space' class='0' field='[federated.nq1poster04].[sum:Normal_Expected_Days:qk]' field-type='quantitative' scope='rows' type='space' scale='log' fold='true' synchronized='true' /><format attr='display' class='0' field='[federated.nq1poster04].[sum:Normal_Expected_Days:qk]' scope='rows' value='false' /><encoding attr='space' class='0' field='[federated.nq1poster04].[none:Return_Bin_Pct:qk]' field-type='quantitative' scope='cols' type='space' range-type='fixed' min='-14' max='18' /><format attr='title' class='0' field='[federated.nq1poster04].[none:Return_Bin_Pct:qk]' scope='cols' value="Daily log return (%, bins of 0.25%)" /></style-rule><style-rule element='gridline'><format attr='stroke-color' value='#E6E6E6' /></style-rule><style-rule element='worksheet'><format attr='font-family' value='Arial' /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow